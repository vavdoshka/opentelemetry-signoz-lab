{
  "schemaVersion": "v6",
  "generateName": true,
  "tags": [
    {
      "key": "tag",
      "value": "lab3"
    }
  ],
  "spec": {
    "display": {
      "name": "Lab 3: pod failures",
      "description": "Throttling, restarts, OOM kills and probe failures in namespace lab3. The community dashboards don't cover these."
    },
    "variables": [],
    "panels": {
      "cpu-throttled": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU throttled, % of periods",
            "description": "Share of 100 ms CPU periods in which the container hit its limit. Metrics: container_cpu_cfs_throttled_periods_total, container_cpu_cfs_periods_total"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "percent",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "composite",
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "stepInterval": 60,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "container_cpu_cfs_throttled_periods_total",
                              "temporality": "",
                              "timeAggregation": "rate",
                              "spaceAggregation": "sum",
                              "reduceTo": "avg"
                            }
                          ],
                          "disabled": true,
                          "filter": {
                            "expression": "namespace = 'lab3'"
                          },
                          "groupBy": [
                            {
                              "name": "pod",
                              "signal": "",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "limit": 20,
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": ""
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "stepInterval": 60,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "container_cpu_cfs_periods_total",
                              "temporality": "",
                              "timeAggregation": "rate",
                              "spaceAggregation": "sum",
                              "reduceTo": "avg"
                            }
                          ],
                          "disabled": true,
                          "filter": {
                            "expression": "namespace = 'lab3'"
                          },
                          "groupBy": [
                            {
                              "name": "pod",
                              "signal": "",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "limit": 20,
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": ""
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "name": "F1",
                          "expression": "(A / B) * 100",
                          "legend": "{{pod}}",
                          "disabled": false
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "cpu-limit": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU used, as a share of the limit",
            "description": "Averaged over 30 seconds, so it reads below 1 even while throttled. Metric: k8s.container.cpu_limit_utilization"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "percentunit",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "k8s.container.cpu_limit_utilization",
                        "temporality": "",
                        "timeAggregation": "avg",
                        "spaceAggregation": "max",
                        "reduceTo": "avg"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "k8s.namespace.name = 'lab3'"
                    },
                    "groupBy": [
                      {
                        "name": "k8s.pod.name",
                        "signal": "",
                        "fieldContext": "resource",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "limit": 20,
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{k8s.pod.name}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "memory-working-set": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memory in use (working set)",
            "description": "The kernel kills the container near its limit, which is 256 MiB here. This is working set, not k8s.container.memory_limit_utilization, which counts page cache: it read 99.5% during a harmless file write. Metric: k8s.pod.memory.working_set"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "bytes",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "k8s.pod.memory.working_set",
                        "temporality": "",
                        "timeAggregation": "max",
                        "spaceAggregation": "max",
                        "reduceTo": "avg"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "k8s.namespace.name = 'lab3'"
                    },
                    "groupBy": [
                      {
                        "name": "k8s.pod.name",
                        "signal": "",
                        "fieldContext": "resource",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "limit": 20,
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{k8s.pod.name}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "restarts": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Container restarts",
            "description": "A running total for each container. A step up is a restart. Metric: k8s.container.restarts"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "k8s.container.restarts",
                        "temporality": "",
                        "timeAggregation": "latest",
                        "spaceAggregation": "max",
                        "reduceTo": "avg"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "k8s.namespace.name = 'lab3'"
                    },
                    "groupBy": [
                      {
                        "name": "k8s.container.name",
                        "signal": "",
                        "fieldContext": "resource",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "limit": 20,
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{k8s.container.name}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "probe-failures": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Failed probes, running total",
            "description": "Shown as a total, not a rate, because a counter's first value has nothing to compare with, so a rate reads 0. Metric: prober_probe_total"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "prober_probe_total",
                        "temporality": "",
                        "timeAggregation": "latest",
                        "spaceAggregation": "sum",
                        "reduceTo": "avg"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "namespace = 'lab3' AND result = 'failed'"
                    },
                    "groupBy": [
                      {
                        "name": "probe_type",
                        "signal": "",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "limit": 20,
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{probe_type}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
