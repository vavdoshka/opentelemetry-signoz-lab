                    "name": "A",
                    "stepInterval": 60,
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "orders.created",
                        "temporality": "",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name = 'backend'"
                    },
                    "groupBy": [
                      {
                        "name": "order.item",
