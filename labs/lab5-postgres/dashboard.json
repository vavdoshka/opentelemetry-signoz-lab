    "variables": [],
    "panels": {
      "blocked": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Sessions blocked on a lock",
            "description": "Sessions stuck waiting for a lock right now. Metric: postgres.sessions.blocked, from the sqlquery receiver."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "postgres.sessions.blocked",
                        "temporality": "",
                        "timeAggregation": "max",
                        "spaceAggregation": "sum",
                        "reduceTo": "avg"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": ""
                    },
                    "groupBy": [],
                    "order": [],
                    "limit": 20,
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "blocked"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
