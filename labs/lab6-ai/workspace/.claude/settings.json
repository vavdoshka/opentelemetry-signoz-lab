{
  "model": "sonnet",
  "enabledMcpjsonServers": [
    "signoz"
  ],
  "permissions": {
    "allow": [
      "mcp__signoz__*",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl * get *)",
      "Bash(kubectl * describe *)",
      "Bash(kubectl * logs *)",
      "Bash(kubectl * top *)"
    ],
    "deny": [
      "mcp__signoz__signoz_create_*",
      "mcp__signoz__signoz_update_*",
      "mcp__signoz__signoz_patch_*",
      "mcp__signoz__signoz_delete_*",
      "mcp__signoz__signoz_import_*",
      "Bash(kubectl apply *)",
      "Bash(kubectl create *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl replace *)",
      "Bash(kubectl scale *)",
      "Bash(kubectl rollout *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl cp *)",
      "Bash(kubectl drain *)",
      "Bash(kubectl cordon *)",
      "Bash(kubectl label *)",
      "Bash(kubectl annotate *)",
      "Bash(kubectl set *)",
      "Bash(kubectl * apply *)",
      "Bash(kubectl * create *)",
      "Bash(kubectl * delete *)",
      "Bash(kubectl * edit *)",
      "Bash(kubectl * patch *)",
      "Bash(kubectl * replace *)",
      "Bash(kubectl * scale *)",
      "Bash(kubectl * rollout *)",
      "Bash(kubectl * exec *)",
      "Bash(kubectl * cp *)",
      "Bash(kubectl * drain *)",
      "Bash(kubectl * cordon *)",
      "Bash(kubectl * label *)",
      "Bash(kubectl * annotate *)",
      "Bash(kubectl * set *)",
      "Write",
      "Edit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch"
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otlp.localhost:8080",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_RESOURCE_ATTRIBUTES": "deployment.environment=lab"
  }
}
